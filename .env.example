# WealthCraft Pro — Environment Configuration
# Default: App runs with local state fallback and simulated Stripe Pro mode out of the box!

# Supabase Configuration (PostgreSQL Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Configuration (₹999/month Pro Tier)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Email Notification Delivery (Sends client/student registrations directly to ya09shu@gmail.com)
# Option A: Gmail SMTP (e.g., using your Gmail and an App Password from Google Account > Security > App Passwords)
SMTP_USER=ya09shu@gmail.com
SMTP_PASS=your_gmail_app_password
# Option B: Custom SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
