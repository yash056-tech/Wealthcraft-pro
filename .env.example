# WealthCraft Pro — Environment Configuration
# Default: App runs with local state fallback and simulated payment modes out of the box!

# Supabase Configuration (PostgreSQL Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Configuration (Direct INR Bank Account Settlements)
# Get keys from Razorpay Dashboard: Settings > API Keys (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Direct Instant Bank UPI QR Configuration (0% gateway fee, settles directly into your bank)
NEXT_PUBLIC_UPI_ID=9935605883@nyes
NEXT_PUBLIC_UPI_PAYEE_NAME=WealthCraft Pro

# Stripe Configuration (Global Debit/Credit Cards & Subscriptions)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Email Notification Delivery (Sends client registrations & payments to ya09shu@gmail.com)
ADMIN_NOTIFICATION_EMAIL=ya09shu@gmail.com
# Option A: Gmail SMTP (Use ya09shu@gmail.com with a 16-character Google App Password)
SMTP_USER=ya09shu@gmail.com
SMTP_PASS=your_gmail_app_password
# Option B: Custom SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
